# Payload and DB
# Local dev and PR previews use the uaic-dev database with the uaic-dev-app user.
# Always include the database name after the host - without it, Payload and
# Better Auth silently fall back to a database called "test".
# mongodb+srv://uaic-dev-app:<password>@uaic-wdcc.4cqadha.mongodb.net/uaic-dev?retryWrites=true&w=majority
DATABASE_URI=
PAYLOAD_SECRET=

# S3
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_BETTER_AUTH_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Email
RESEND_API_KEY=
EMAIL_RECIPIENT=

# Test member (written by `pnpm seed-test-member`)
TEST_MEMBER_EMAIL=
TEST_MEMBER_PASSWORD=
